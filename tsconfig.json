{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@screens/*": ["src/screens/*"],
      "@components/*": ["src/components/*"],
      "@utils/*": ["src/utils/*"],
      "@navigation/*": ["src/navigation/*"],
      "@routes/*": ["src/routes/*"] ,
      "@values/*": ["src/resources/values/*"],
      "@assets/*": ["src/resources/assets/*"],
      "@strings/*": ["src/resources/locale/*"],
    }
  },
  "include": ["src"]
}
