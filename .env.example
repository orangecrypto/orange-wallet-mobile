# Orange Wallet Environment Variables
# Copy this file to .env and fill in your actual API keys

# OrangeSeed API Key - Required for blockchain data access (seed.orangewebservices.com)
# Used by orangeseed library functions: fetchAppInfo, getOrdinalsFtBalance, getBrc20History, etc.
ORANGESEED_API_KEY=your_orangeseed_api_key_here

# CoinGecko API Key - Required for cryptocurrency price data (api.coingecko.com)
# Primary source for all price fetching with caching and rate limiting
# Free tier provides better rate limits than public API
# Get your free API key at: https://www.coingecko.com/en/api
COINGECKO_API_KEY=your_coingecko_api_key_here

# Orange Market Cap API Key - Fallback for market data (api-orange-marketcap.orangewebservices.com)
# Used as fallback when CoinGecko is rate limited or unavailable
ORANGE_MARKETCAP_API_KEY=your_marketcap_api_key_here
